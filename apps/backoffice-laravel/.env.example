APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# JSON key de una Service Account de Google Cloud (Calendar API), fuera del repo.
# Ver docs/OPI_PRODUCCION.md. Sin esto, calendario:sincronizar-google queda inerte.
GOOGLE_CALENDAR_CREDENTIALS_PATH=

VITE_APP_NAME="${APP_NAME}"
BACKOFFICE_USE_VITE_HOT=false

BACKOFFICE_PROFILING=true
BACKOFFICE_PROFILING_HEADERS=true
BACKOFFICE_SLOW_REQUEST_MS=250
BACKOFFICE_SLOW_QUERY_MS=80
BACKOFFICE_PROFILING_LOG_CHANNEL=stack
BACKOFFICE_CATALOG_CACHE_TTL_SECONDS=1800
BACKOFFICE_RESOURCE_CLEANING_BUFFER_MINUTES=15

BACKOFFICE_PET_IMAGE_MAX_SIZE=1600
BACKOFFICE_PET_IMAGE_QUALITY=82
BACKOFFICE_PET_THUMB_WIDTH=160
BACKOFFICE_PET_THUMB_HEIGHT=120
BACKOFFICE_PET_THUMB_QUALITY=68

BACKOFFICE_OPERATOR_IMAGE_MAX_SIZE=1200
BACKOFFICE_OPERATOR_IMAGE_QUALITY=82
BACKOFFICE_OPERATOR_THUMB_SIZE=160
BACKOFFICE_OPERATOR_THUMB_QUALITY=70

BACKOFFICE_RESOURCE_IMAGE_MAX_SIZE=1600
BACKOFFICE_RESOURCE_IMAGE_QUALITY=82
BACKOFFICE_RESOURCE_THUMB_WIDTH=160
BACKOFFICE_RESOURCE_THUMB_HEIGHT=120
BACKOFFICE_RESOURCE_THUMB_QUALITY=68
